<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>2.0.0</Version>
    <ToolCommandName>fastmcp</ToolCommandName>
    <Description>Command-line interface for the DotnetFastMCP framework.</Description>
  </PropertyGroup>

  <ItemGroup>
     <!-- Added System.CommandLine to supply SetHandler, AddCommand, InvokeAsync extensions -->
    <PackageReference Include="System.CommandLine" Version="2.0.0" /> 
  </ItemGroup>

   <ItemGroup>
    <ProjectReference Include="..\FastMCP\FastMCP.csproj" />
  </ItemGroup>

</Project>
